+          information.SetBarkerPreambleMode (1);
+        }
+    }
+  return information;
+}
+
+HtOperations
+ApWifiMac::GetHtOperations (void) const
+{
+  HtOperations operations;
+  operations.SetHtSupported (1);
+  if (m_htSupported)
+    {
+      if (!m_nonHtStations.empty ())
+        {
+          operations.SetHtProtection (MIXED_MODE_PROTECTION);
