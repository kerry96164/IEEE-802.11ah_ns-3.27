+              spectrumPhy.Set ("ChannelWidth", UintegerValue (40));
+            }
+          else
+            {
+              spectrumPhy.Set ("ShortGuardEnabled", BooleanValue (true));
+              spectrumPhy.Set ("ChannelWidth", UintegerValue (40));
+            }
+        }
+      else
+        {
