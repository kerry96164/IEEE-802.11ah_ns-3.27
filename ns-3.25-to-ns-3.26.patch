+  {
+      // case 15:
+      WifiHelper wifi;
+      wifi.SetRemoteStationManager ("ns3::IdealWifiManager");
+      wifi.SetStandard (WIFI_PHY_STANDARD_80211n_5GHZ);
+      staDevice = wifi.Install (phy, macSta, wifiStaNode.Get(0));
+      phySta = GetYansWifiPhyPtr (staDevice);
