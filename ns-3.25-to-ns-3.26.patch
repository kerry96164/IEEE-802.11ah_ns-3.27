+              spectrumPhy.Set ("ChannelWidth", UintegerValue (20));
+            }
+          else if (i > 7 && i <= 15)
+            {
+              spectrumPhy.Set ("ShortGuardEnabled", BooleanValue (true));
+              spectrumPhy.Set ("ChannelWidth", UintegerValue (20));
+            }
+          else if (i > 15 && i <= 23)
