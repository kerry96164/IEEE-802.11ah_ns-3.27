+++ ns-3.26/src/traffic-control/model/fq-codel-queue-disc.cc	2016-10-03 19:49:01.608387944 -0700
@@ -0,0 +1,396 @@
+/* -*- Mode:C++; c-file-style:"gnu"; indent-tabs-mode:nil; -*- */
+/*
