+  Config::SetDefault ("ns3::RedQueueDisc::MaxTh", DoubleValue (15));
+  Config::SetDefault ("ns3::RedQueueDisc::QueueLimit", UintegerValue (1000));
+
+  if (aredTest == 1) // test 1: red1
