+/**
+ * Returns the current time translated in CoDel time representation
+ * \return the current time
+ */
+static uint32_t CoDelGetTime (void)
+{
+  Time time = Simulator::Now ();
+  uint64_t ns = time.GetNanoSeconds ();
+
+  return ns >> CODEL_SHIFT;
+}
