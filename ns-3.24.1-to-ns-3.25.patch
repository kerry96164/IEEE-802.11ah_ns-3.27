+  g_intervalRate = newVal;
+}
+
+struct Step
+{
+  double stepSize;
+  double stepTime;
+};
+
+struct StandardInfo
+{
+  StandardInfo ()
+  {
+    m_name = "none";
+  }
+  StandardInfo (std::string name, enum WifiPhyStandard standard, uint32_t width, bool sgi, double snrLow, double snrHigh, double xMin, double xMax, double yMax)
+    : m_name (name),
+      m_standard (standard),
+      m_width (width),
