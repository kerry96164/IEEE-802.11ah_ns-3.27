+
+private:
+  // De-multiplexing callbacks.
+  void NormalCloseCb  (Ptr<Socket> socket);
+  void ErrorCloseCb   (Ptr<Socket> socket);
+  void QueueDropCb    (std::string context, Ptr<const Packet> p);
