+MinstrelHtWifiManager::CalculateMpduTxDuration (Ptr<WifiPhy> phy, uint8_t streams, uint8_t sgi, uint32_t chWidth, WifiMode mode)
+{
+  NS_LOG_FUNCTION (this << phy << (int)streams << (int)sgi << chWidth << mode);
