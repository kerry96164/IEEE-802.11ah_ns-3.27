+
+using namespace ns3;
+
+NS_LOG_COMPONENT_DEFINE ("RedTests");
+
+uint32_t checkTimes;
+double avgQueueSize;
+
+// The times
+double global_start_time;
+double global_stop_time;
+double sink_start_time;
+double sink_stop_time;
+double client_start_time;
+double client_stop_time;
+
+NodeContainer n0n2;
