-{
-public:
-  static TypeId GetTypeId (void);
-
-  WifiTxCurrentModel ();
-  virtual ~WifiTxCurrentModel ();
-
-  /**
-   * \param txPowerDbm the nominal tx power in dBm
-   * \returns the transmit current (in Ampere)
